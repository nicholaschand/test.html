<!-- ===================== CONTACT / QUOTE FORM =====================
     Netlify Forms. Netlify scans this static HTML at deploy time for
     data-netlify="true" and registers the form automatically, no
     dashboard setup, no email swap, no activation step. Submissions
     trigger a webhook into n8n for the client's lead-response automation. -->
<section id="contact">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Get a quote</div>
      <h2>[Section headline]</h2>
    </div>
    <div class="contact-panel">
      <div>
        <p style="color:var(--paper-dim);font-size:15px;margin-bottom:20px;">[One or two sentences on response time / what happens after they submit.]</p>
        <a href="tel:[PHONE]" class="btn btn-primary">Call [PHONE DISPLAY]</a>
      </div>
      <form id="quoteForm" name="quote" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <!-- required so Netlify's build-time scanner links submissions to this form -->
        <input type="hidden" name="form-name" value="quote">
        <!-- honeypot: hidden from real visitors, catches spam bots that fill every field -->
        <p style="position:absolute;left:-9999px;">
          <label>Don't fill this out: <input name="bot-field"></label>
        </p>

        <div class="field-row">
          <div class="field"><label for="name">Name</label><input id="name" name="Name" required></div>
          <div class="field"><label for="phone">Phone</label><input id="phone" name="Phone" type="tel" required></div>
        </div>
        <div class="field-row">
          <div class="field"><label for="suburb">Suburb</label><input id="suburb" name="Suburb" required></div>
          <div class="field">
            <label for="jobtype">Job type</label>
            <!-- edit these options to match the client's actual services -->
            <select id="jobtype" name="Job type">
              <option>[Service 1]</option>
              <option>[Service 2]</option>
              <option>[Service 3]</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="field"><label for="details">What's happening?</label><textarea id="details" name="Details" rows="3" required></textarea></div>
        <button type="submit" class="btn btn-primary">Request quote</button>
        <!-- hidden until JS shows it after a successful/failed send -->
        <div class="confirm" id="confirmMsg"></div>
      </form>
    </div>
  </div>
</section>

